# Copy to .env.local and fill in to make the enquiry form send email via https://resend.com
RESEND_API_KEY=
# Sender address on a domain you've verified in Resend, e.g. "Al Wahda Website <website@alwahdatradingwll.com>"
ENQUIRY_FROM=
# Where enquiries go (defaults to info@alwahdatradingwll.com)
ENQUIRY_TO=
